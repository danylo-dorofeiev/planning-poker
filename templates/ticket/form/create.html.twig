<turbo-frame id="ticket_create_form">
    <div data-controller="form">
        <button type="button" data-action="click->form#open" data-form-target="target">Create Ticket</button>

        <div data-form-target="form" style="display: none">
            <button type="button" data-action="click->form#close">Close</button>

            {{ form_start(form, { action: path('ticket_create', {room_id:room.uuid}), method: 'POST' }) }}

            {{ form_widget(form) }}

            <button type="submit">Create</button>

            {{ form_end(form) }}
        </div>
    </div>
</turbo-frame>
