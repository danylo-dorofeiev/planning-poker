<div data-controller="create-ticket-form">
    <button
        type="button"
        data-action="click->create-ticket-form#open"
        data-create-ticket-form-target="createFormButton"
    >
        Create Ticket
    </button>

    <div
        data-create-ticket-form-target="form"
        style="display: none"
    >
        <button
            type="button"
            data-action="click->create-ticket-form#close"
        >
            Close
        </button>

        {{ form_start(form, {
            action: path('ticket_create', {uuid: room.uuid}),
            method: 'POST'
        }) }}

        {{ form_widget(form) }}

        <button type="submit">
            Create
        </button>

        {{ form_end(form) }}
    </div>
</div>

