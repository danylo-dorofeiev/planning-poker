{% if action == "prepend" %}
    <turbo-stream action="prepend" target="ticket_list">
        <template>
            {% include 'ticket/elements/_ticket_card.html.twig' with { room:room, ticket:ticket|default(0), round:round, ticketEditForm:ticketEditForms[ticket.uuid] } %}
        </template>
    </turbo-stream>
{% endif %}

{% if action == "replace" %}
    <turbo-stream action="replace" target="ticket-{{ ticket.uuid }}">
        <template>
            {% include 'ticket/elements/_ticket_card.html.twig' with { room:room, ticket:ticket, round:round, ticketEditForm:ticketEditForms[ticket.uuid] } %}
        </template>
    </turbo-stream>
{% endif %}

{% if action == "remove" %}
    <turbo-stream action="remove" target="ticket-{{ ticket_id }}"></turbo-stream>
{% endif %}

