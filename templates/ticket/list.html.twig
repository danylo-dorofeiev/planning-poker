{% extends 'base.html.twig' %}

{% block title %}Ticket List{% endblock %}

{% block body %}

    <h1>Ticket List</h1>

    <style>
        table, th, td {
            border: 1px black solid;
            border-collapse: collapse;
        }
    </style>

    <table>
        <thead>
        <tr>
            <th>Key</th>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Created at</th>
            <th>Updated at</th>
            <th>Room</th>
        </tr>
        </thead>
        <tbody>
        {% for ticket in tickets %}
            <tr>
                <td>{{ ticket.key }}</td>
                <td>{{ ticket.title }}</td>
                <td>{{ ticket.description }}</td>
                <td>{{ ticket.status.value }}</td>
                <td>{{ ticket.createdAt|date('d.m.Y H:i') }}</td>
                <td>{{ ticket.updatedAt|date('d.m.Y H:i') }}</td>
                <td>{{ ticket.getRoomUuid() }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
