<tr id="ticket-{{ ticket.id }}">
    <td>{{ ticket.key }}</td>
    <td>{{ ticket.title }}</td>
    <td>{{ ticket.description }}</td>
    <td>{{ ticket.status.value }}</td>
    <td>{{ ticket.createdAt|date('d.m.Y H:i') }}</td>
    <td>{{ ticket.updatedAt|date('d.m.Y H:i') }}</td>
    {% if is_granted('ROUND_START', ticket.room) %}
        <td>
            <form
                method="post"
                action="{{ path('round_start', {
                    room_id: ticket.room.uuid,
                    ticket_id: ticket.uuid
                }) }}"
            >
                <button type="submit">Start Voting</button>
            </form>
        </td>
    {% endif %}
    <td
        data-controller="ticket-popup"
        data-ticket-popup-show-url-value="{{ path('ticket_show', {
            room_id: ticket.room.uuid,
            ticket_id: ticket.uuid
        }) }}"
    >
        <button
            type="button"
            data-action="click->ticket-popup#open"
        >
            Open
        </button>
        <div
            data-ticket-popup-target="modal"
            style="display: none"
            data-action="click->ticket-popup#closeOnOverlay"
        >
            <div>
                <div data-ticket-popup-target="content"></div>
            </div>
        </div>
    </td>
</tr>
