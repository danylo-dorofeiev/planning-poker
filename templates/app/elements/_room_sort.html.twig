<div data-controller="dropdown" data-action="click@window->dropdown#clickOutside" class="relative">
    <div data-action="click->dropdown#toggle" class="relative group">
        <twig:Button type="secondary" size="small">
            {% if sortDirection == "asc" %}
                {{ icon('sort_up', 'w-4! h-4! stroke-secondary-gray') }}
            {% elseif sortDirection = "desc" %}
                {{ icon('sort_down', 'w-4! h-4! stroke-secondary-gray') }}
            {% else %}
                {{ icon('sort_down', 'w-4! h-4! stroke-secondary-gray') }}
            {% endif %}
            Sortieren
            {{ icon('arrow_list', 'w-3 h-3 stroke-secondary-gray') }}
        </twig:Button>
    </div>

    <twig:Dropdown width="180">
        <form method="get">
            <ol class="flex gap-1">
                <li data-action="click->dropdown#close" class="relative w-full">
                    {% if sortDirection == "asc" %}
                        <twig:Button type="secondary" size="smallest" css="w-full!">
                            {{ icon('sort_up', 'w-5 h-5') }}
                        </twig:Button>
                    {% else %}
                        <twig:Button func="submit" name="sortDirection" value="asc" type="ghost" size="smallest" css="w-full!">
                            {{ icon('sort_up', 'w-5 h-5 stroke-secondary-gray') }}
                        </twig:Button>
                    {% endif %}
                </li>

                <li data-action="click->dropdown#close" class="relative w-full">
                    {% if not sortDirection or sortDirection == "desc" %}
                        <twig:Button type="secondary" size="smallest" css="w-full!">
                            {{ icon('sort_down', 'w-5 h-5') }}
                        </twig:Button>
                    {% else %}
                        <twig:Button func="submit" name="sortDirection" value="desc" type="ghost" size="smallest" css="w-full!">
                            {{ icon('sort_down', 'w-5 h-5 stroke-secondary-gray') }}
                        </twig:Button>
                    {% endif %}
                </li>
            </ol>

            {% if status %}
                <input type="hidden" name="status" value="{{ status }}">
            {% endif %}

            {% if sortOption %}
                <input type="hidden" name="sortOption" value="{{ sortOption }}">
            {% endif %}

            {% if search %}
                <input type="hidden" name="search" value="{{ search }}">
            {% endif %}
        </form>

        <form method="get" class="mt-1">
            <ol class="flex flex-col gap-1">
                <li data-action="click->dropdown#close" class="relative">
                    {% if not sortOption or sortOption == "updated" %}
                        <twig:Button type="secondary" size="smaller" css="w-full justify-start!">
                            {{ icon('clock', 'w-5 h-5') }}
                            Aktualisierung
                        </twig:Button>
                    {% else %}
                        <twig:Button func="submit" name="sortOption" value="updated" type="ghost" size="smaller" css="w-full justify-start!">
                            {{ icon('clock', 'w-5 h-5 stroke-secondary-gray') }}
                            Aktualisierung
                        </twig:Button>
                    {% endif %}
                </li>

                <li data-action="click->dropdown#close" class="relative">
                    {% if sortOption == "created" %}
                        <twig:Button type="secondary" size="smaller" css="w-full justify-start!">
                            {{ icon('calender', 'w-5 h-5') }}
                            Erstellung
                        </twig:Button>
                    {% else %}
                        <twig:Button func="submit" name="sortOption" value="created" type="ghost" size="smaller" css="w-full justify-start!">
                            {{ icon('calender', 'w-5 h-5 stroke-secondary-gray') }}
                            Erstellung
                        </twig:Button>
                    {% endif %}
                </li>

                <li data-action="click->dropdown#close" class="relative">
                    {% if sortOption == "name" %}
                        <twig:Button type="secondary" size="smaller" css="w-full justify-start!">
                            {{ icon('label', 'w-5 h-5') }}
                            Name
                        </twig:Button>
                    {% else %}
                        <twig:Button func="submit" name="sortOption" value="name" type="ghost" size="smaller" css="w-full justify-start!">
                            {{ icon('label', 'w-5 h-5 stroke-secondary-gray') }}
                            Name
                        </twig:Button>
                    {% endif %}
                </li>
            </ol>

            {% if status %}
                <input type="hidden" name="status" value="{{ status }}">
            {% endif %}

            {% if sortDirection %}
                <input type="hidden" name="sortDirection" value="{{ sortDirection }}">
            {% endif %}

            {% if search %}
                <input type="hidden" name="search" value="{{ search }}">
            {% endif %}
        </form>
    </twig:Dropdown>
</div>
