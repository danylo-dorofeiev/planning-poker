<div class="flex-1 flex flex-row-reverse border border-secondary-gray-700 rounded-lg p-4 bg-primary-black-900">
    <div data-controller="dropdown" data-action="click@window->dropdown#clickOutside" class="h-fit relative">
        <div data-action="click->dropdown#toggle" class="relative group">
            <twig:Button type="smooth" size="smaller">
                {{ icon('dots_vertical', 'w-4 h-4') }}
            </twig:Button>

            <twig:Tooltip position="bottom left">
                Options
            </twig:Tooltip>
        </div>

        <twig:Dropdown width="180">
            <ol class="flex flex-col">
                <li data-action="click->dropdown#close">
                    <twig:Button link="{{ path('room_show', {room_id:room.uuid}) }}" type="ghost" size="smaller" css="w-full justify-start!">
                        {{ icon('door_enter', 'w-5! h-5! stroke-secondary-gray') }}
                        Beitreten
                    </twig:Button>
                </li>

                <li>
                    <hr class="my-2">
                </li>

                <li data-action="click->dropdown#close">
                    <twig:Button type="ghost" size="smaller" css="w-full justify-start! text-red-500! hover:bg-red-950!" modal="room_{{ room.uuid }}_delete_modal">
                        {{ icon('trash', 'w-5! h-5! stroke-red-500') }}
                        Löschen
                    </twig:Button>
                </li>
            </ol>
        </twig:Dropdown>
    </div>

    <div class="flex-1 flex flex-col gap-1">
        <a href="{{ path('room_show', {room_id:room.uuid}) }}" class="w-fit text-xl! hover:underline">
            {{ room.name }}
        </a>

        <div class="flex flex-col gap-3">
            <p class="text-balance text-secondary-gray-400!">
                {% if room.description %}
                    {{ room.description }}
                {% else %}
                    ...
                {% endif %}
            </p>

            <div class="flex gap-3 flex-wrap">
                <div class="relative group">
                    <span class="flex gap-1 text-xs! text-secondary-gray-400!">
                        {{ icon('profile', 'w-4 h-4 stroke-secondary-gray') }}
                        {{ room.members.count() }}
                    </span>

                    <twig:Tooltip delay="1000">
                        Mitglieder
                    </twig:Tooltip>
                </div>

                {% if room.tickets.count() > 0 %}
                    <div class="relative group">
                        <span class="flex gap-1 text-xs! text-secondary-gray-400!">
                            {{ icon('ticket', 'w-4 h-4 stroke-secondary-gray') }}
                            {{ room.tickets.count() }}
                        </span>

                        <twig:Tooltip delay="1000">
                            Tickets
                        </twig:Tooltip>
                    </div>
                {% endif %}

                <div class="relative group">
                    <span class="flex gap-1 text-xs! text-secondary-gray-400!">
                        {{ icon('calender', 'w-4 h-4 stroke-secondary-gray') }}
                        {{ room.createdAt|format_datetime(pattern='MMM dd, yyyy', locale='en', timezone='Europe/Berlin') }}
                    </span>

                    <twig:Tooltip delay="1000">
                        Erstellt am
                    </twig:Tooltip>
                </div>

                <div class="relative group">
                    <span class="flex gap-1 text-xs! text-secondary-gray-400!">
                        {{ icon('clock', 'w-4 h-4 stroke-secondary-gray') }}
                        {{ room.updatedAt|format_datetime(pattern='MMM dd, yyyy – HH:mm', locale='en', timezone='Europe/Berlin') }}
                    </span>

                    <twig:Tooltip delay="1000">
                        Aktualisiert am
                    </twig:Tooltip>
                </div>
            </div>
        </div>
    </div>
</div>

<twig:Modal width="350" modal="room_{{ room.uuid }}_delete_modal" :x="false">
    <div class="flex flex-col gap-1 justify-center items-center">
        {{ icon('trash', 'w-12! h-12! stroke-red-500') }}

        <h4>Raum löschen?</h4>

        <p class="text-balance text-center text-secondary-grey-light!">Ihr Raum wird endgültig gelöscht und kann nicht wiederhergestellt werden.</p>

        <div class="flex gap-2 mt-3">
            <button type="button" popovertarget="room_{{ room.uuid }}_delete_modal" popovertargetaction="hide" class="btn-small btn-secondary">
                Cancel
            </button>

            <form method="POST" action="{{ path('room_delete', {room_id:room.uuid}) }}">
                <button type="submit" class="btn-danger btn-small">
                    Löschen
                </button>
            </form>
        </div>
    </div>
</twig:Modal>
