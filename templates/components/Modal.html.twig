<dialog {% if not turbo %}id="{{ modal }}"{% endif %} {% if turbo %}data-controller="modal" data-modal-target="dialog"{% endif %} popover style="max-width: {{ width }}px">
    {% if title or x %}
        <div class="flex gap-3 items-start justify-between pb-2 border-b border-b-secondary-gray-700">
            {% if title %}
                <h5 class="w-fit">
                    {{ title }}
                </h5>
            {% endif %}

            {% if reset or x %}
                <div class="flex-1 flex gap-2 items-start justify-end">
                    {% if reset %}
                        <div class="relative group">
                            <button
                                type="reset"
                                form="{{ reset }}"
                                class="btn-smaller btn-smooth"
                            >
                                {{ icon('rotate', 'w-4! h-4! stroke-secondary-grey-light') }}
                            </button>

                            <twig:Tooltip position="bottom left">
                                Zurücksetzen
                            </twig:Tooltip>
                        </div>
                    {% endif %}

                    {% if x %}
                        <div class="relative group">
                            <button
                                type="button"
                                {% if turbo %} data-action="click->modal#close"
                                {% else %} popovertarget="{{ modal }}"
                                {% endif %}
                                popovertargetaction="hide"
                                class="btn-smaller btn-smooth ml-auto"
                            >
                                {{ icon('x', 'w-4! h-4! stroke-secondary-grey-light') }}
                            </button>

                            <twig:Tooltip position="bottom left">
                                Schließen
                            </twig:Tooltip>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if turbo %}
        {{ block('content') }}
        <turbo-frame id="{{ modal }}" data-action="turbo:frame-render->modal#open"></turbo-frame>
    {% else %}
        {{ block('content') }}
    {% endif %}
</dialog>
