<div data-controller="dropdown" class="relative group">
    <div data-action="click->dropdown#toggle">
        {{ block('toggle') }}
    </div>

    <div data-dropdown-target="menu" class="absolute opacity-0 -translate-y-2 pointer-events-none transition-all duration-200 z-10
        {% if position=="bottom center" %} top-full left-1/2 -translate-x-1/2 pt-1
        {% elseif position=="bottom left" %} top-full right-0 pt-1
        {% elseif position=="bottom right" %} top-full left-0 pt-1

        {% elseif position=="top center" %} bottom-full left-1/2 -translate-x-1/2 pb-1
        {% elseif position=="top left" %} bottom-full right-0 pb-1
        {% elseif position=="top right" %} bottom-full left-0 pb-1
        {% endif %}">

        <div style="width: {{ width }}px" class="bg-primary-black border border-secondary-gray-700 rounded-lg p-2">
            {{ block('content') }}
        </div>
    </div>
</div>
