{% if settings_link %}
    <a href="{{ path('app_profile') }}">
{% endif %}
        <div class="bg-secondary-grey rounded-full flex justify-center items-center cursor-pointer
                {% if size == 'small' %}w-9 h-9
                {% elseif size == 'medium' %}w-10 h-10
                {% elseif size == 'large'%}w-12 h-12
                {% endif %}
        ">
            <span class="uppercase select-none
                        {% if size == 'small' %}text-sm!
                        {% elseif size == 'medium' %}text-base!
                        {% elseif size == 'large'%}text-lg!

                        {% else %} text-base!
                        {% endif %}
            ">
                {{ app.user.initials }}
            </span>
        </div>
{% if settings_link %}
    </a>
{% endif %}
