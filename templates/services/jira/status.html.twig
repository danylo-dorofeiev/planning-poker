{% extends 'layout/app.html.twig' %}

{% block title %}Jira Verbindung Status{% endblock %}

{% block body %}
        <main class="flex">
            <section class="flex-1/3 min-h-full border-r border-secondary-gray-700 bg-primary-black-900">
                <div class="flex flex-col gap-6 h-full items-center justify-center">
                    <div class="size-50"
                         style="background: url('{{ asset("images/logo/services/jira_logo.svg") }}');
                             background-size: contain;
                             background-repeat: no-repeat;
                             background-position: center center;"
                    ></div>
                </div>
            </section>

            <section class="flex-2/3 flex flex-col p-6">
                <div class="flex-1 flex flex-col gap-3 w-180 mx-auto">
                    <div class="flex-1 justify-center flex flex-col gap-3">
                        {% if status == "connected" %}
                            <div class="bg-accent-700/30 border border-accent rounded-md p-4 flex flex-col items-center gap-2">
                                {{ icon('check_circle', 'w-8 h-8 stroke-accent') }}

                                <span class="text-xl! text-accent!">
                                    Die Verbindung ist aktiv.
                                </span>
                            </div>

                            <span class="text-xs! text-center text-secondary-gray!">
                                Diese Seite kann gschlossen werden.
                            </span>
                        {% elseif status == "connection_error" %}
                            {{ icon('error', 'w-8 h-8 stroke-red-500') }}

                            <span class="text-xl!">
                                Verbindungsfehler.
                            </span>

                            <twig:Button link="{{ path('jira_connect') }}" type="secondary" size="medium">
                                {{ icon('rotate', 'w-4.5 h-4.5') }}
                                Erneu versuchen
                            </twig:Button>
                        {% else %}

                            {{ icon('plug_connected_x', 'w-8 h-8') }}

                            <span class="text-xl!">
                                Es gibt keine aktive Verbindung.
                            </span>

                            <twig:Button link="{{ path('jira_connect') }}" type="primary" size="medium">
                                {{ icon('link', 'w-4.5 h-4.5') }}
                                Mir Jira Verbinden
                            </twig:Button>
                        {% endif %}
                    </div>

                    {% include 'partials/app/footer.html.twig' %}
                </div>
            </section>
        </main>
{% endblock %}

