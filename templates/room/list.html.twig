{% extends 'base.html.twig' %}

{% block title %}Room List{% endblock %}

{% block body %}

    <h1>Room List</h1>

    <style>
        table, th, td {
            border: 1px black solid;
            border-collapse: collapse;
        }
    </style>

    <table>
        <thead>
            <tr>
                <th>Uuid</th>
                <th>Name</th>
                <th>Description</th>
                <th>Max Users</th>
                <th>Created at</th>
                <th>Tickets</th>
                <th>Deck</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for room in rooms %}
            <tr>
                <td>{{ room.uuid }}</td>
                <td>{{ room.name }}</td>
                <td>{{ room.description }}</td>
                <td>{{ room.createdAt|date('d.m.Y H:i') }}</td>
                <td>
                    {% for ticket in room.tickets %}
                        {{ ticket.title }}
                    {% endfor %}
                </td>
                <td>{{ room.deck.name }}</td>
                <td><a href="{{ path('room_show', {uuid:room.uuid}) }}"><button>Open</button></a></td>
                <td><a href="{{ path('room_edit', {uuid:room.uuid}) }}"><button>Edit</button></a></td>
                <td>
                    <form method="post" action="{{ path('room_delete', {uuid: room.uuid}) }}">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('room_create') }}"><button>Create a Room</button></a>
{% endblock %}
