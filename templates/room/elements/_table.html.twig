<div id="poker_table">
    {% if activeRound %}
        <h2>Round {{ activeRound.number }} - id: {{ activeRound.id }}</h2>
        <span>Status: {{ activeRound.status.value }}</span>

        <h3>{{ activeRound.ticket.title }}</h3>

        {% if activeRound.ticket.description %}
            <p>{{ activeRound.ticket.description }}</p>
        {% endif %}

        {% if activeRound.status.value == 'active' %}

            <div data-controller="vote"
                 data-vote-vote-url-value="{{ path('round_vote', {
                     room_id:activeRound.ticket.room.uuid,
                     ticket_id:activeRound.ticket.uuid,
                     round_id:activeRound.id
                 }) }}"
            >
                {% for card in activeRound.cards %}
                    <button type="button"
                            data-value="{{ card.value }}"
                            data-action="click->vote#submit"
                    >{{ card.value }}</button>
                {% endfor %}
            </div>

            {% if is_granted('ROUND_REVEAL', activeRound.ticket.room) %}
                <form method="post" action="{{ path('round_reveal', {room_id:activeRound.ticket.room.uuid, ticket_id:activeRound.ticket.uuid, round_id:activeRound.id}) }}">
                    <button type="submit">Reveal</button>
                </form>
            {% endif %}

        {% else %}
            {% for vote in activeRound.votes %}
                <p>{{ vote.user.email }} - {{ vote.value }}</p>
            {% endfor %}
        {% endif %}
    {% endif %}
</div>
