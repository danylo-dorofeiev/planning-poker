<div id="room_settings"
     data-mercure-target="stream"
     class="flex items-center gap-2
">
    <span class="text-nowrap">
        {{ room.name }}
    </span>

    {% if room.owner == app.user %}
        <twig:Button type="ghost" size="smallest" modal="room_settings_modal">
            {{ icon('pencil', 'w-4! h-4! stroke-secondary-grey-light') }}
        </twig:Button>

        <twig:Modal modal="room_settings_modal" title="Raum Info Bearbeiten" reset="room_settings_form" width="600">
            {{ form_start(roomSettingsForm) }}

            <div class="flex flex-col gap-3">
                <div class="flex flex-col gap-1">
                    {{ form_label(roomSettingsForm.name) }}
                    {{ form_widget(roomSettingsForm.name) }}
                </div>

                <div class="flex flex-col gap-1">
                    {{ form_label(roomSettingsForm.description) }}
                    {{ form_widget(roomSettingsForm.description) }}
                </div>

                <div class="flex gap-2 items-end justify-end mt-1">
                    <button type="button" popovertarget="{{ modal }}" popovertargetaction="hide" class="btn-small btn-secondary">
                        Cancel
                    </button>

                    <button type="submit" class="btn-primary btn-small">
                        Speichern
                    </button>
                </div>
            </div>

            {{ form_end(roomSettingsForm) }}
        </twig:Modal>

        <twig:Dropdown>
            <twig:block name="toggle">
                <twig:Button type="smooth" size="smaller" css="text-primary-white! text-nowrap">
                    {{ icon('play_card', 'w-5! h-5! stroke-secondary-gray') }}
                    {{ room.deck.name }}
                    {{ icon('arrow_list', 'w-3! h-3! stroke-secondary-gray') }}
                </twig:Button>

                <twig:Tooltip position="bottom left">
                    Deck auswählen
                </twig:Tooltip>
            </twig:block>

            <twig:block name="content">
                <ol class="flex flex-col gap-1">
                    <li>
                        <span class="text-xs! text-secondary-gray! px-2">
                            System
                        </span>
                    </li>

                    <hr>

                    {% for deck in systemDecks %}
                        <li>
                            {% if deck !== room.deck %}
                                <form method="post" action="{{ path('deck_select', {room_id:room.uuid, deck_id:deck.uuid}) }}">
                                    <twig:Button :dropdown_close="true" func="submit" type="ghost" size="small" css="justify-start!">
                                        {{ deck.name }}
                                    </twig:Button>
                                </form>
                            {% else %}
                                <twig:Button :dropdown_close="true" type="secondary" size="small" css="justify-start!">
                                    {{ deck.name }}
                                </twig:Button>
                            {% endif %}
                        </li>
                    {% endfor %}

                    {% if userDecks %}
                        <li>
                            <span class="text-xs! text-secondary-gray! px-2">
                                Benutzerdefiniertes
                            </span>
                        </li>

                        <hr>

                        {% for deck in userDecks %}
                            <li>
                                {% if deck !== room.deck %}
                                    <form method="post" action="{{ path('deck_select', {room_id:room.uuid, deck_id:deck.uuid}) }}">
                                        <twig:Button :dropdown_close="true" func="submit" type="ghost" size="small" css="justify-start!">
                                            {{ deck.name }}
                                        </twig:Button>
                                    </form>
                                {% else %}
                                    <twig:Button :dropdown_close="true" type="secondary" size="small" css="justify-start!">
                                        {{ deck.name }}
                                    </twig:Button>
                                {% endif %}
                            </li>
                        {% endfor %}
                    {% endif %}
                </ol>
            </twig:block>
        </twig:Dropdown>
    {% endif %}
</div>
