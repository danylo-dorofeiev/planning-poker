{% extends 'base.html.twig' %}

{% block title %}Room{% endblock %}

{% block body %}

    <h1>Room</h1>

    {% include('room/elements/_settings.html.twig') %}

    {% if is_granted('ROOM_EDIT', room) %}
        <a href="{{ path('room_edit', {uuid:room.uuid}) }}"><button>Edit</button></a>
    {% endif %}

    {% if is_granted('ROOM_DELETE', room) %}
        <form method="post" action="{{ path('room_delete', {uuid: room.uuid}) }}">
            <button type="submit">Delete</button>
        </form>
    {% endif %}

    <hr>

    <div data-controller="form">

        <h2>Tickets</h2>

        <style>
            table, th, td {
                border: 1px black solid;
                border-collapse: collapse;
            }
        </style>

        <table>
            <thead>
            <tr>
                <th>Key</th>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Created at</th>
                <th>Updated at</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
            </thead>
            <tbody id="tickets">
                {% for ticket in room.tickets %}
                    {% include('ticket/elements/_card.html.twig') %}
                {% endfor %}
            </tbody>
        </table>

        <br>

        <div data-form-target="form" style="display: none"></div>

        {% include('ticket/form/create_form.html.twig') %}

        <hr>
        {% include('room/elements/_table.html.twig') %}

        <!-- mercure stream source -->
        {% include('mercure/stream_source.html.twig') %}
    </div>
{% endblock %}
