{% extends 'base.html.twig' %}

{% block title %}Room{% endblock %}

{% block body %}

    <h1>Room</h1>

    <h2>Room Settings</h2>
    <ul>
        <li>Uuid: {{ room.uuid }}</li>
        <li>Name: {{ room.name }}</li>
        <li>Description: {{ room.description }}</li>
        <li>Deck: {{ room.deck.name }}</li>
        <li>Created at: {{ room.createdAt|date('d.m.Y H:i') }}</li>
    </ul>

    {% if is_granted('ROOM_EDIT', room) %}
        <a href="{{ path('room_edit', {uuid:room.uuid}) }}"><button>Edit</button></a>
    {% endif %}

    {% if is_granted('ROOM_DELETE', room) %}
        <form method="post" action="{{ path('room_delete', {uuid: room.uuid}) }}">
            <button type="submit">Delete</button>
        </form>
    {% endif %}
    <hr>

    <div data-controller="form">

        <h2>Tickets</h2>

        <style>
            table, th, td {
                border: 1px black solid;
                border-collapse: collapse;
            }
        </style>

        <table>
            <thead>
            <tr>
                <th>Key</th>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Created at</th>
                <th>Updated at</th>
                <th></th>
                <th></th>
            </tr>
            </thead>
            <tbody id="tickets">
                {% for ticket in room.tickets %}
                    {% include('ticket/elements/_card.html.twig') %}
                {% endfor %}
            </tbody>
        </table>

        <br>

        <div data-form-target="form" style="display: none"></div>

        <br>

        <turbo-frame id="ticket_create">{% include('ticket/form/create_form.html.twig') %}</turbo-frame>

        <!-- mercure stream -->
        <turbo-stream-source src="{{ mercure(room.uuid) }}"></turbo-stream-source>
    </div>
{% endblock %}
