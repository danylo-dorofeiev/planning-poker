{% extends 'base.html.twig' %}

{% block title %}Room{% endblock %}

{% block body %}

    <h1>Room</h1>

    <h2>Room Settings</h2>
    <ul>
        <li>Uuid: {{ room.uuid }}</li>
        <li>Name: {{ room.name }}</li>
        <li>Description: {{ room.description }}</li>
        <li>Max Users: {{ room.maxUsers }}</li>
        <li>Created at: {{ room.createdAt|date('d.m.Y H:i') }}</li>
    </ul>

    <a href="{{ path('room_edit', {uuid:room.uuid}) }}"><button>Edit</button></a>

    <form method="post" action="{{ path('room_delete', {uuid: room.uuid}) }}">
        <button type="submit">Delete</button>
    </form>

    <hr>

    <div data-controller="form">

        <h2>Tickets</h2>

        <style>
            table, th, td {
                border: 1px black solid;
                border-collapse: collapse;
            }
        </style>

        <table>
            <thead>
            <tr>
                <th>Key</th>
                <th>Title</th>
                <th>Description</th>
                <th>Status</th>
                <th>Created at</th>
                <th>Updated at</th>
                <th></th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for ticket in room.tickets %}
                <tr>
                    <td>{{ ticket.key }}</td>
                    <td>{{ ticket.title }}</td>
                    <td>{{ ticket.description }}</td>
                    <td>{{ ticket.status.value }}</td>
                    <td>{{ ticket.createdAt|date('d.m.Y H:i') }}</td>
                    <td>{{ ticket.updatedAt|date('d.m.Y H:i') }}</td>
                    <td>
                        <button
                            type="button"
                            data-action="click->form#fetch"
                            data-url="{{ path('ticket_edit', {uuid: room.uuid, id: ticket.id}) }}"
                        >Edit</button>
                    </td>
                    <td>
                        <form method="post" action="{{ path('ticket_delete', {uuid: room.uuid, id:ticket.id}) }}">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <br>

        <div data-form-target="form" style="display: none"></div>

        <br>

        {{ include('ticket/_create_form.html.twig') }}
    </div>
{% endblock %}
