{% extends 'layout/app.html.twig' %}

{% block title %}{{ room.name }}{% endblock %}

{% block content %}
    <main class="flex-1 flex">
        {% include 'partials/app/sidebar.html.twig' %}

        <aside id="sidebar" class="flex-1 max-w-85 border-r border-secondary-gray-700 bg-primary-black-900 transition-all duration-300">
            <div class="max-h-[calc(100vh-65px)] sticky top-0 overflow-hidden">
                <div class="flex flex-col gap-3 p-6">
                    <div class="flex gap-3 justify-between items-center">

                        <div class="flex gap-1.5 items-center">
                            {{ icon('users', 'w-5 h-5 stroke-secondary-gray stroke-2!') }}

                            <h5>
                                Participants
                            </h5>
                        </div>

                        <div class="relative group">
                            <twig:Button type="ghost" size="smaller" modal="add_user_modal">
                                {{ icon('link', 'w-5 h-5 stroke-secondary-gray') }}
                            </twig:Button>

                            <twig:Tooltip position="bottom left">
                                Mitglied hinzufügen
                            </twig:Tooltip>
                        </div>

                        <twig:Modal modal="add_user_modal" width="450" :x="false">
                            <div class="flex flex-col gap-3">

                                <div data-controller="clipboard" class="flex flex-col gap-3">
                                    <div class="flex gap-3 justify-between items-center">
                                        <span class="text-sm! text-secondary-gray! flex gap-1.5 items-center">
                                            {{ icon('share', 'w-4 h-4 stroke-secondary-gray') }}
                                            Link teilen
                                        </span>

                                        <div class="relative group">
                                            {{ icon('info', 'w-4 h-4 stroke-secondary-gray') }}

                                            <twig:Tooltip position="bottom left">
                                                Bitte veröffentlichen Sie den Link nicht öffentlich.
                                            </twig:Tooltip>
                                        </div>
                                    </div>

                                    <div class="relative">
                                        <input
                                            type="text"
                                            data-clipboard-target="input"
                                            value="https://planning-poker.quantumfrog.de/room/{{ room.uuid }}"
                                            class="relative w-full pr-10!"
                                        >

                                        <button
                                            type="button"
                                            data-clipboard-target="copyButton"
                                            data-action="clipboard#copy"
                                            class="btn-ghost btn-smaller absolute top-1/2 right-1 -translate-y-1/2"
                                        >
                                            {{ icon('copy', 'w-3.5! h-3.5!') }}
                                        </button>

                                        <button
                                            disabled
                                            type="button"
                                            data-clipboard-target="checkButton"
                                            data-action="clipboard#copy"
                                            class="hidden! btn-ghost btn-smaller absolute top-1/2 right-1 -translate-y-1/2"
                                        >
                                            {{ icon('check', 'w-3.5! h-3.5! stroke-secondary-gray') }}
                                        </button>
                                    </div>
                                </div>

                                <div data-controller="clipboard" class="flex flex-col gap-3 items-start">
                                    <p class="text-sm! text-secondary-gray! flex gap-1">
                                        ...oder den

                                        <span
                                            data-clipboard-target="copyButton"
                                            data-action="click->clipboard#copy"
                                            class="text-accent! hover:underline cursor-pointer flex gap-1 items-center"
                                        >
                                            Raum-ID
                                            {{ icon('copy', 'w-4 h-4 stroke-accent') }}
                                        </span>

                                        <span
                                            data-clipboard-target="checkButton"
                                            class="hidden! text-secondary-gray! flex gap-1 items-center"
                                        >
                                            Raum-ID
                                            {{ icon('check', 'w-4 h-4 stroke-secondary-gray') }}
                                        </span>

                                        teilen.
                                    </p>

                                    <input
                                        hidden
                                        type="text"
                                        data-clipboard-target="input"
                                        value="{{ room.uuid }}"
                                        class="hidden"
                                    >
                                </div>
                            </div>
                        </twig:Modal>
                    </div>

                    <hr>

                    {% include 'room/elements/_member_list.html.twig' with {room:room, members:room.members, votedUserIds:votedUserIds} %}
                </div>
            </div>
        </aside>

        <section class="flex-1 flex flex-col">
            <div class="sticky top-0 p-4">
                {% include 'room/elements/_poker_table.html.twig' with {room:room, round:round, votedUserIds:votedUserIds} %}
            </div>
        </section>

        <aside class="flex-1 max-w-120 min-h-dvh">
            <div data-controller="ticket-create-form" class="p-6 flex flex-col gap-3">
                <div class="flex gap-3 items-end">

                    <div class="flex gap-1.5 items-center">
                        {{ icon('ticket', 'w-5 h-5 stroke-secondary-gray') }}

                        <h5>
                            Tickets
                        </h5>
                    </div>


                    <div class="ml-auto flex gap-2">
                        <twig:Dropdown width="180" position="bottom left">
                            <twig:block name="toggle">
                                <twig:Button type="secondary" size="small" css="text-nowrap">
                                    {{ icon('export', 'w-4! h-4! stroke-secondary-gray') }}
                                    Tickets Import
                                    {{ icon('arrow_list', 'w-3 h-3 stroke-secondary-gray') }}
                                </twig:Button>
                            </twig:block>

                            <twig:block name="content">
                                <ol class="flex flex-col gap-1">
                                    <li data-action="click->dropdown#close">
                                        <twig:Button data_turbo_frame='jira_import' link="{{ path('jira_projects', {room_id: room.uuid}) }}" type="ghost" size="smaller" css="w-full justify-start!">
                                            {{ icon('jira', 'w-5 h-5 stroke-secondary-gray') }}
                                            Aus Jira
                                        </twig:Button>
                                    </li>
                                </ol>
                            </twig:block>
                        </twig:Dropdown>

                        <button type="button" data-action="click->ticket-create-form#toggle" class="btn-primary btn-small text-nowrap" data-turbo-permanent>
                            {{ icon('plus', 'w-4! h-4!') }}
                            Create Ticket
                        </button>
                    </div>
                </div>

                <div data-ticket-create-form-target="form" class="max-h-0 border border-secondary-grey-light/40 border-b-0 rounded-lg bg-secondary-grey/10 p-0 overflow-hidden transition-all duration-300 ease-in-out">
                    <div class="flex flex-col p-3 border-b border-secondary-grey-light/40!">
                        <div class="flex items-start gap-2 justify-between">
                            <h5>Neues Ticket erstellen</h5>

                            <div class="relative group">
                                <button type="button" data-action="click->ticket-create-form#toggle" class="btn-smooth btn-smaller ml-auto">
                                    {{ icon('x', 'w-4! h-4!') }}
                                </button>

                                <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-opacity duration-150 absolute top-full right-0 items-center pt-1">
                                    <span class="text-xs! font-light! bg-secondary-grey px-2 py-1.5 rounded-sm text-nowrap brightness-110">
                                        Close
                                    </span>
                                </div>
                            </div>
                        </div>

                        {{ form_start(ticketCreateForm, {
                            attr: {
                                'class': 'flex flex-col gap-3 w-full',
                                'data-controller': 'ticket-create-form',
                                'data-action': 'submit->ticket-create-form#submit',
                            }
                        }) }}

                        <div class="flex gap-3">
                            <div class="w-1/5">
                                {{ form_row(ticketCreateForm.key, {
                                    row_attr: { class: 'w-full flex flex-col gap-0.5' },
                                    label_attr: { class: 'text-secondary-grey-light!'},
                                    attr: { class: 'w-full' }
                                }) }}
                            </div>

                            <div class="w-4/5">
                                {{ form_row(ticketCreateForm.title, {
                                    row_attr: { class: 'w-full flex flex-col gap-0.5' },
                                    label_attr: { class: 'text-secondary-grey-light!'},
                                    attr: { class: 'w-full' }
                                }) }}
                            </div>
                        </div>

                        {{ form_row(ticketCreateForm.description, {
                            row_attr: { class: 'w-full flex flex-col gap-0.5' },
                            label_attr: { class: 'text-secondary-grey-light!' },
                            attr: { class: 'w-full' }
                        }) }}

                        <button type="submit" class="btn-primary btn-small mr-auto">Create</button>

                        {{ form_end(ticketCreateForm) }}
                    </div>
                </div>

                {% include 'ticket/elements/_ticket_card_list.html.twig' with {room:room, tickets:tickets, activeRound:activeRound|default(0)} %}
            </div>
        </aside>
    </main>

    <twig:Modal modal="room_{{ room.uuid }}_delete_modal" :x="false" width="350">
        <div class="flex flex-col gap-1 justify-center items-center">
            {{ icon('trash', 'w-12! h-12! stroke-red-500') }}

            <h4>Raum löschen?</h4>

            <p class="text-balance text-center text-secondary-grey-light!">Ihr Raum wird endgültig gelöscht und kann nicht wiederhergestellt werden.</p>

            <div class="flex gap-2 mt-3">
                <button type="button" popovertarget="room_{{ room.uuid }}_delete_modal" popovertargetaction="hide" class="btn-small btn-secondary">
                    Cancel
                </button>

                <form method="POST" action="{{ path('room_delete', {room_id:room.uuid}) }}">
                    <button type="submit" class="btn-danger btn-small">
                        Löschen
                    </button>
                </form>
            </div>
        </div>
    </twig:Modal>

    <twig:Modal :turbo="true" modal="jira_import" title="Jira Tickets Import" width="600">
        <!-- Jira Projects Overview -->
    </twig:Modal>
{% endblock %}
