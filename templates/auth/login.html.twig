{% extends 'layout/public.html.twig' %}

{% block title %}Login - Planning Poker{% endblock %}

{% block body %}
<main class="flex flex-col">
    <section class="flex-1 w-full h-full flex items-center justify-center">
        <div class="flex flex-col gap-6 w-90 p-6 border border-secondary-gray-700 rounded-lg">
            <twig:Logo size="medium" :isDemo="false"/>

            <form id="sign_in" method="post" class="flex flex-col gap-3">
                {% if error %}
                    <div class="flex gap-1.5 items-center text-red-500! alert alert-danger">
                        {{ icon('error', 'w-5 h-5 stroke-red-500') }}
                        {% if error.messageKey|trans(error.messageData, 'security') == "Invalid credentials." %}
                            Ungültige Anmeldedaten.
                        {% else %}
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        {% endif %}
                    </div>
                {% endif %}

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}

                <div class="flex flex-col gap-3">
                    <div class="flex flex-col gap-1">
                        <label for="inputEmail">
                            E-Mail
                        </label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="inputPassword">
                            Passwort
                        </label>
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                    <div class="checkbox">
                        <label>
                            <input type="checkbox" name="_remember_me" class="mr-1.5">
                            Angemeldet bleiben
                        </label>
                    </div>
                </div>

                <div class="flex flex-col gap-3 mt-3">
                    <twig:Button func="submit" size="large" type="primary" css="mx-auto w-full text-center!">
                        Anmelden
                    </twig:Button>

                    <span class="text-secondary-gray-400! flex gap-3">
                        Noch kein Konto?
                        <a href="{{ path('app_register') }}" class="flex items-center gap-1.5">
                            Sign up
                            {{ icon('login', 'w-5 h-5') }}
                        </a>
                    </span>
                </div>
            </form>
        </div>
    </section>
</main>

{% include('partials/public/footer.html.twig') %}
{% endblock %}
