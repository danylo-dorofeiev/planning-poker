<div data-controller="form">
    <button
        type="button"
        data-action="click->form#open"
        data-form-target="target"
    >Create Deck</button>

    <div data-form-target="form" style="display: none">
        <button type="button" data-action="click->form#close">Close</button>

        {{ form_start(form, {
            action: path('deck_create'),
            method: 'POST',
            attr: {
                'data-controller': 'form',
                'data-action': 'submit->form#validate',
            }
        }) }}

        {{ form_row(form.name) }}

        {{ form_errors(form.cards) }}

        <div
            data-controller="collection"
            data-collection-index-value="{{ form.cards|length }}"
            data-collection-prototype-value="{{ form_widget(form.cards.vars.prototype)|e('html_attr') }}"
        >
            <div data-collection-target="items">
                {% for cardForm in form.cards %}
                    <div class="card-item">
                        {{ form_row(cardForm.value) }}
                        <button type="button" data-action="collection#remove">Delete</button>
                    </div>
                {% endfor %}
            </div>

            <button type="button" data-action="collection#add">Add Card</button>
        </div>

        <button type="submit">Create Deck</button>

        {{ form_end(form) }}
    </div>
</div>
