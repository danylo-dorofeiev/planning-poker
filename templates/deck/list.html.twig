{% extends 'base.html.twig' %}

{% block title %}Deck List{% endblock %}

{% block body %}
<h1>Deck List</h1>

<style>
    table, th, td {
        border: 1px black solid;
        border-collapse: collapse;
    }
</style>

<table>
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
    </tr>
    </thead>
    <tbody>
    {% for deck in decks %}
        <tr>
            <td>{{ deck.id }}</td>
            <td>{{ deck.name }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<br>

<div data-controller="form">
    <button
        type="button"
        data-action="click->form#open"
        data-form-target="target"
    >Create Deck</button>

    <div data-form-target="form" style="display: none">
        <button
            type="button"
            data-action="click->form#close"
        >Close</button>

        {{ form_start(form, {
            action: path('deck_create'),
            method: 'POST'
        }) }}

        {{ form_widget(form) }}

        <button type="submit">
            Create
        </button>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
