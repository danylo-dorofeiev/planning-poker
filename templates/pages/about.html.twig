{% extends 'base.html.twig' %}

{% block title %}Planning Poker{% endblock %}

{% block body %}

    <section class="flex mt-10">
        <div class="flex-2/3 flex flex-col gap-5">
            <h1 class="text-7xl!">Schätzen. Abstimmen. <br> Gemeinsam entscheiden.</h1>

            <p class="text-base! text-balance">
                Schätzen Sie Aufgaben gemeinsam im Team, erkennen Sie Risiken frühzeitig und schaffen Sie ein
                gemeinsames Verständnis für die Anforderungen, bevor die Entwicklung beginnt.
            </p>

            <div class="flex gap-3 mt-2">
                <a href="{{ path('room_join') }}" class="btn-primary text-base! px-4! py-2!">Room beitreten</a>
                <a href="{{ path('room_create') }}" class="btn-secondary text-base! px-4! py-2!">Room erstellen</a>

                {% if app.user %}
                    <a href="{{ path('room_list') }}">Room List</a>
                    <a href="{{ path('deck_list') }}">Deck List</a>
                {% endif %}
            </div>
        </div>
        <div class="flex-1/3 bg-secondary-grey"></div>
    </section>

{% endblock %}

